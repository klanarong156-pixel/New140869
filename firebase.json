{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.rules.json",
      "database.rules.json",
      ".firebaserc",
      ".firebaseignore",
      ".gitignore",
      ".env",
      ".env.*",
      "**/.*",
      "node_modules/**",
      "**/node_modules/**",
      ".github/**",
      "test/**",
      "*.md",
      "**/*.md",
      "*.mjs",
      "**/*.mjs",
      "*.py",
      "**/*.py",
      "*.txt",
      "**/*.txt",
      "*.ino",
      "**/*.ino",
      "*.bin",
      "**/*.bin",
      "*.elf",
      "**/*.elf",
      "*.zip",
      "**/*.zip",
      "*.log",
      "**/*.log"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.@(html|js|css|json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "redirects": [
      { "source": "/dashboard", "destination": "/index.html", "type": 302 },
      { "source": "/dashboard/**", "destination": "/index.html", "type": 302 },
      { "source": "/finance.html", "destination": "/index.html#legacy", "type": 302 },
      { "source": "/control-room", "destination": "/index.html", "type": 302 },
      { "source": "/control-room/**", "destination": "/index.html", "type": 302 }
    ]
  },
  "database": {
    "rules": "firebase.rules.json"
  }
}
