{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.rules.json",
      "database.rules.json",
      ".firebaserc",
      ".firebaseignore",
      ".gitignore",
      ".env",
      ".env.*",
      "**/.*",
      "node_modules/**",
      "**/node_modules/**",
      "functions/**",
      "archive/**",
      "tools/**",
      "test/**",
      "examples/**",
      "src/**",
      ".pio/**",
      ".github/**",
      "*.ino",
      "**/*.ino",
      "*.bin",
      "**/*.bin",
      "*.elf",
      "**/*.elf",
      "*.md",
      "**/*.md",
      "*.mjs",
      "**/*.mjs",
      "*.py",
      "**/*.py",
      "*.log",
      "**/*.log",
      "*.zip",
      "**/*.zip",
      "platformio.ini",
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "README.txt",
      "BUILD_REPORT.txt",
      "BUILD_STATUS.txt",
      "SYSTEM_VERSION.txt"
    ],
    "cleanUrls": false,
    "trailingSlash": false
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "database": {
    "rules": "firebase.rules.json"
  }
}
